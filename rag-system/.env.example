# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here

# ── Microsoft Graph / MSAL ─────────────────────────────────────────────────
# Register an app at https://portal.azure.com → App registrations
# Platform: Web  |  Redirect URI: http://localhost:5000/auth/callback
# API permissions (Delegated): User.Read, Mail.Read, Calendars.Read,
#   Sites.Read.All (admin consent required), Files.Read.All, offline_access

AZURE_CLIENT_ID=your_app_client_id
AZURE_CLIENT_SECRET=your_client_secret_value
AZURE_TENANT_ID=your_oracle_tenant_id

# Optional — override the OAuth redirect URI (default: http://localhost:5000/auth/callback)
# AZURE_REDIRECT_URI=http://localhost:5000/auth/callback

# Optional — fix the Flask session secret so sessions survive restarts
# SECRET_KEY=generate_with_python_-c_"import_secrets;print(secrets.token_hex(32))"
